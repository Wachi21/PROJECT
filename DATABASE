-- ---------------------------------------------------------------------
-- Triggers: บันทึกประวัติอัตโนมัติทุกครั้งที่จองหรือยกเลิก
-- แอปเวอร์ชัน MySQL ไม่เขียน history เอง ต้องมี trigger สองตัวนี้
-- ไม่เช่นนั้นหน้า "ดูประวัติ" จะว่างเปล่า
-- ---------------------------------------------------------------------
DROP TRIGGER IF EXISTS trg_bookings_after_insert;
DROP TRIGGER IF EXISTS trg_bookings_before_delete;

DELIMITER $$

CREATE TRIGGER trg_bookings_after_insert
AFTER INSERT ON bookings
FOR EACH ROW
BEGIN
    INSERT INTO history
        (room_id, room_name, booking_date, slot_id, slot_label, booker_name, purpose, action)
    SELECT NEW.room_id, r.room_name, NEW.booking_date, NEW.slot_id, s.slot_label,
           NEW.booker_name, NEW.purpose, 'จอง'
    FROM rooms r
    JOIN time_slots s ON s.slot_id = NEW.slot_id
    WHERE r.room_id = NEW.room_id;
END$$

CREATE TRIGGER trg_bookings_before_delete
BEFORE DELETE ON bookings
FOR EACH ROW
BEGIN
    INSERT INTO history
        (room_id, room_name, booking_date, slot_id, slot_label, booker_name, purpose, action)
    SELECT OLD.room_id, r.room_name, OLD.booking_date, OLD.slot_id, s.slot_label,
           OLD.booker_name, OLD.purpose, 'ยกเลิก'
    FROM rooms r
    JOIN time_slots s ON s.slot_id = OLD.slot_id
    WHERE r.room_id = OLD.room_id;
END$$

DELIMITER ;

-- ---------------------------------------------------------------------
-- View: รายการจองพร้อมชื่อห้องและคาบเวลา (อ่านง่ายสำหรับดูข้อมูล)
-- ---------------------------------------------------------------------
CREATE OR REPLACE VIEW v_booking_details AS
SELECT b.booking_id,
       b.booking_date,
       r.room_name,
       r.building,
       s.slot_label,
       b.booker_name,
       b.purpose,
       b.created_at
FROM bookings b
JOIN rooms r      ON r.room_id  = b.room_id
JOIN time_slots s ON s.slot_id  = b.slot_id
ORDER BY b.booking_date, r.room_name, s.start_time;


