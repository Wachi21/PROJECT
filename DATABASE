-- equipment : รายการอุปกรณ์/สิ่งอำนวยความสะดวกทั้งหมด
CREATE TABLE IF NOT EXISTS equipment (
    equipment_id   VARCHAR(20) NOT NULL,
    equipment_name VARCHAR(60) NOT NULL,
    PRIMARY KEY (equipment_id)
) ENGINE=InnoDB;

-- room_equipment : ห้องไหนมีอุปกรณ์อะไรกี่ชิ้น (ความสัมพันธ์ many-to-many)
CREATE TABLE IF NOT EXISTS room_equipment (
    room_id      VARCHAR(20) NOT NULL,
    equipment_id VARCHAR(20) NOT NULL,
    quantity     TINYINT UNSIGNED NOT NULL DEFAULT 1,
    PRIMARY KEY (room_id, equipment_id),
    CONSTRAINT fk_re_room
        FOREIGN KEY (room_id) REFERENCES rooms (room_id)
        ON UPDATE CASCADE ON DELETE CASCADE,
    CONSTRAINT fk_re_equipment
        FOREIGN KEY (equipment_id) REFERENCES equipment (equipment_id)
        ON UPDATE CASCADE ON DELETE CASCADE
) ENGINE=InnoDB;

-- booking_details : ข้อมูลเพิ่มเติมของการจอง (1 การจอง : 1 แถว)
-- ถ้ายกเลิกการจอง แถวนี้จะถูกลบตามอัตโนมัติ
CREATE TABLE IF NOT EXISTS booking_details (
    booking_id  INT UNSIGNED NOT NULL,
    booker_code VARCHAR(20)  NULL COMMENT 'รหัสนักศึกษา/พนักงาน',
    phone       VARCHAR(20)  NULL,
    attendees   SMALLINT UNSIGNED NULL COMMENT 'จำนวนผู้เข้าใช้ห้อง',
    PRIMARY KEY (booking_id),
    CONSTRAINT fk_bd_booking
        FOREIGN KEY (booking_id) REFERENCES bookings (booking_id)
        ON UPDATE CASCADE ON DELETE CASCADE
) ENGINE=InnoDB;

