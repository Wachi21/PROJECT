def date_options():
    today = date.today()
    days = [today + timedelta(days=i) for i in range(DAYS_AHEAD)]
    labels = []
    for i, d in enumerate(days):
        top = "วันนี้" if i == 0 else THAI_WEEKDAYS[d.weekday()]
        labels.append(f"{top}\n{d.day} {THAI_MONTHS[d.month - 1]}")
    return days, labels


def mix(hex_color, with_white_ratio):
    """ผสมสีกับสีขาวเพื่อให้ได้เฉดอ่อนลง"""
    h = hex_color.lstrip("#")
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    r = int(r + (255 - r) * with_white_ratio)
    g = int(g + (255 - g) * with_white_ratio)
    b = int(b + (255 - b) * with_white_ratio)
    return f"#{r:02x}{g:02x}{b:02x}"


def hex_to_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def rgb_to_hex(rgb):
    return "#{:02x}{:02x}{:02x}".format(*rgb)


def blend(c1, c2, t):
    a, b = hex_to_rgb(c1), hex_to_rgb(c2)
    return rgb_to_hex(tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3)))


def draw_gradient(canvas, w, h, c1, c2, vertical=False, steps=60, tag="grad"):
    for i in range(steps):
        t0, t1 = i / steps, (i + 1) / steps
        color = blend(c1, c2, t0)
        if vertical:
            canvas.create_rectangle(0, h * t0, w, h * t1 + 1, fill=color, outline=color, tags=tag)
        else:
            canvas.create_rectangle(w * t0, 0, w * t1 + 1, h, fill=color, outline=color, tags=tag)


