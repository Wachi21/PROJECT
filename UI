def make_app_icon():
    """สร้างไอคอนแอปด้วย PhotoImage ไม่ต้องใช้ไฟล์รูป"""
    size = 64
    img = tk.PhotoImage(width=size, height=size)
    cx = cy = (size - 1) / 2
    r = 31
    for y in range(size):
        for x in range(size):
            d2 = (x - cx) ** 2 + (y - cy) ** 2
            if d2 <= r * r:
                img.put("#C89B3C" if d2 > (r - 3) ** 2 else "#FFFFFF", (x, y))
    img.put("#7D1934", to=(16, 20, 48, 50))
    img.put("#F2A300", to=(16, 20, 48, 29))
    img.put("#5C0E24", to=(21, 15, 24, 24))
    img.put("#5C0E24", to=(40, 15, 43, 24))
    pts = [(22 + t, 36 + t) for t in range(0, 9)] + [(30 + t, 44 - t) for t in range(0, 15)]
    for px, py in pts:
        img.put("#FFFFFF", to=(px, py, px + 3, py + 3))
    return img


def bind_mousewheel(canvas):
    """เลื่อนด้วยลูกกลิ้งเมาส์เฉพาะตอนเมาส์อยู่เหนือ canvas นี้ (รวมการ์ดที่อยู่ข้างใน)"""
    def _wheel(event):
        try:
            w = canvas.winfo_containing(event.x_root, event.y_root)
            while w is not None and w is not canvas:
                w = w.master
            if w is None:
                return
            if getattr(event, "num", None) == 4:
                step = -1
            elif getattr(event, "num", None) == 5:
                step = 1
            else:
                step = -1 if event.delta > 0 else 1
            canvas.yview_scroll(step, "units")
        except tk.TclError:
            pass

    for seq in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
        canvas.bind_all(seq, _wheel, add="+")


def bind_click(widget, handler):
    """ผูกการคลิกกับ widget และลูกทั้งหมด (ใช้กับการ์ดที่คลิกได้ทั้งใบ)"""
    widget.bind("<Button-1>", lambda e: handler())
    for child in widget.winfo_children():
        bind_click(child, handler)


def recolor(widget, bg=None, fg_map=None):
    """เปลี่ยนสีพื้นของ widget และลูกทั้งหมด (ข้าม Frame ที่ทำหน้าที่เป็นแถบสี)"""
    if getattr(widget, "keep_color", False):
        return
    if bg is not None:
        try:
            widget.config(bg=bg)
        except tk.TclError:
            pass
    if fg_map and isinstance(widget, tk.Label):
        kind = getattr(widget, "kind", None)
        if kind in fg_map:
            widget.config(fg=fg_map[kind])
    for child in widget.winfo_children():
        recolor(child, bg, fg_map)


