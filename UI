class App:
    def __init__(self, root):
        self.root = root
        self.user = None
        root.title("KMITL Classroom Booking - จองห้องเรียนออนไลน์")
        self.app_icon = make_app_icon()
        root.iconphoto(True, self.app_icon)
        root.configure(bg=BG)
        setup_styles()
        self.show_auth()

    def _clear(self):
        for w in self.root.winfo_children():
            w.destroy()
        for seq in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            self.root.unbind_all(seq)

    def show_auth(self, confirm=False):
        if confirm and not messagebox.askyesno("ออกจากระบบ", "ต้องการออกจากระบบใช่หรือไม่?"):
            return
        self.user = None
        self._clear()
        self.root.minsize(900, 680)
        self.root.geometry("980x700")
        AuthScreen(self.root, on_login=self.on_login).pack(fill="both", expand=True)

    def on_login(self, user):
        self.user = user
        self._clear()
        self.root.minsize(900, 700)
        self.root.geometry("1000x760")
        MainScreen(self.root, user, on_logout=lambda: self.show_auth(confirm=True)).pack(
            fill="both", expand=True)


if __name__ == "__main__":
    root = tk.Tk()
    try:
        init_db()
    except Exception as err:
        root.withdraw()
        messagebox.showerror("เชื่อมต่อฐานข้อมูลไม่ได้", describe_db_error(err))
        root.destroy()
    else:
        App(root)
        root.mainloop()

