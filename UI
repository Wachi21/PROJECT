def fetch_history(limit=200):
    conn = get_conn()
    try:
        cur = conn.cursor(dictionary=True)
        cur.execute(
            """
            SELECT logged_at, action, room_name, booking_date AS date,
                   slot_label, booker_name, purpose
            FROM history ORDER BY history_id DESC LIMIT %s
            """,
            (limit,),
        )
        rows = cur.fetchall()
        cur.close()
    finally:
        conn.close()
    for row in rows:
        row["logged_at"] = str(row["logged_at"])
        row["date"] = str(row["date"])
    return rows


def fetch_bookings(room_id, iso_date):
    conn = get_conn()
    try:
        cur = conn.cursor(dictionary=True)
        cur.execute(
            """
            SELECT b.booking_id AS id, b.slot_id, b.booking_date AS date,
                   b.booker_name, b.purpose, b.user_id, u.role AS booker_role,
                   d.booker_code, d.phone, d.attendees
            FROM bookings b
            LEFT JOIN users u ON u.user_id = b.user_id
            LEFT JOIN booking_details d ON d.booking_id = b.booking_id
            WHERE b.room_id = %s AND b.booking_date = %s
            """,
            (room_id, iso_date),
        )
        rows = cur.fetchall()
        cur.close()
    finally:
        conn.close()
    for row in rows:
        row["date"] = str(row["date"])
        row["booker_role"] = _text(row["booker_role"])
    return {row["slot_id"]: row for row in rows}


def fetch_my_bookings(user_id):
    conn = get_conn()
    try:
        cur = conn.cursor(dictionary=True)
        cur.execute(
            """
            SELECT b.booking_id, b.booking_date, s.slot_label, r.room_name, b.purpose
            FROM bookings b
            JOIN rooms r      ON r.room_id = b.room_id
            JOIN time_slots s ON s.slot_id = b.slot_id
            WHERE b.user_id = %s AND b.booking_date >= CURDATE()
            ORDER BY b.booking_date, s.start_time
            """,
            (user_id,),
        )
        rows = cur.fetchall()
        cur.close()
    finally:
        conn.close()
    return rows


def insert_booking(room_id, iso_date, slot_id, user_id, name, purpose,
                   code="", phone="", attendees=None):
    """คืน True ถ้าจองสำเร็จ / False ถ้ามีคนจองคาบนี้ไปแล้ว"""
    conn = get_conn()
    try:
        cur = conn.cursor()
        try:
            cur.execute(
                """
                INSERT INTO bookings (room_id, booking_date, slot_id, user_id, booker_name, purpose)
                VALUES (%s, %s, %s, %s, %s, %s)
                """,
                (room_id, iso_date, slot_id, user_id, name, purpose),
            )
            booking_id = cur.lastrowid
            if code or phone or attendees is not None:
                cur.execute(
                    """
                    INSERT INTO booking_details (booking_id, booker_code, phone, attendees)
                    VALUES (%s, %s, %s, %s)
                    """,
                    (booking_id, code or None, phone or None, attendees),
                )
            conn.commit()
            return True
        except mysql.connector.IntegrityError as err:
            conn.rollback()
            if err.errno == 1062:      # Duplicate entry = คาบนี้ถูกจองแล้ว
                return False
            raise
        finally:
            cur.close()
    finally:
        conn.close()


def delete_booking(booking_id, user_id):
    """ลบการจองของตัวเองเท่านั้น (trigger ใน MySQL บันทึกประวัติ 'ยกเลิก' ให้เอง)
    คืน True ถ้าลบได้ / False ถ้าไม่พบหรือไม่ใช่การจองของผู้ใช้คนนี้"""
    conn = get_conn()
    try:
        cur = conn.cursor()
        cur.execute("DELETE FROM bookings WHERE booking_id = %s AND user_id = %s",
                    (booking_id, user_id))
        deleted = cur.rowcount > 0
        conn.commit()
        cur.close()
        return deleted
    finally:
        conn.close()


