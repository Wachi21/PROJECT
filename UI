        frame = tk.Frame(self, bg=PANEL)
        frame.pack(fill="both", expand=True, padx=14, pady=(14, 6))
        columns = ("date", "slot", "room", "purpose")
        self.tree = ttk.Treeview(frame, columns=columns, show="headings", selectmode="browse")
        for col, (text, width) in {"date": ("วันที่", 100), "slot": ("คาบ", 120),
                                   "room": ("ห้อง", 130), "purpose": ("วัตถุประสงค์", 260)}.items():
            self.tree.heading(col, text=text)
            self.tree.column(col, width=width, anchor="w")
        self.tree.pack(side="left", fill="both", expand=True)
        bar = ttk.Scrollbar(frame, command=self.tree.yview)
        bar.pack(side="right", fill="y")
        self.tree.configure(yscrollcommand=bar.set)

        self.empty = tk.Label(frame, text="ยังไม่มีการจองที่กำลังจะมาถึง", bg="white", fg=MUTED,
                              font=(FONT, 10))
        bottom = tk.Frame(self, bg=PANEL)
        bottom.pack(fill="x", padx=14, pady=(4, 14))
        ColorButton(bottom, color=DANGER, text="✖ ยกเลิกรายการที่เลือก", padx=12, pady=6,
                    font=(FONT, 9, "bold"), command=self.cancel_selected).pack(side="right")
        self.load()

    def load(self):
        self.tree.delete(*self.tree.get_children())
        rows = fetch_my_bookings(self.user["id"])
        for row in rows:
            d = row["booking_date"]
            self.tree.insert("", "end", iid=str(row["booking_id"]), values=(
                f"{d.day} {THAI_MONTHS[d.month - 1]} {d.year}", _text(row["slot_label"]),
                _text(row["room_name"]), _text(row["purpose"])))
        if rows:
            self.empty.place_forget()
        else:
            self.empty.place(relx=0.5, rely=0.55, anchor="center")

    def cancel_selected(self):
        sel = self.tree.selection()
        if not sel:
            messagebox.showinfo("ยกเลิกการจอง", "เลือกรายการที่ต้องการยกเลิกก่อน", parent=self)
            return
        if not messagebox.askyesno("ยืนยัน", "ยกเลิกการจองรายการนี้ใช่หรือไม่?", parent=self):
            return
        try:
            delete_booking(int(sel[0]), self.user["id"])
            self.load()
        except Exception as err:
            messagebox.showerror("ฐานข้อมูลมีปัญหา", describe_db_error(err), parent=self)
            return
        self.on_change()


