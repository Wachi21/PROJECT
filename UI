        body.pack(fill="both", expand=True)

        tk.Label(body, text="✏️  จองคาบเวลา", font=(FONT, 10), bg=PANEL, fg=MUTED).pack(anchor="w")
        tk.Label(body, text=slot_label, font=(FONT, 15, "bold"), bg=PANEL, fg=INK).pack(
            anchor="w", pady=(0, 12))

        who = tk.Frame(body, bg=mix(room_color, 0.9), padx=12, pady=8)
        who.pack(fill="x", pady=(0, 14))
        tk.Label(who, text="ผู้จอง", font=(FONT, 8), bg=who["bg"], fg=MUTED).pack(anchor="w")
        row = tk.Frame(who, bg=who["bg"])
        row.pack(anchor="w")
        tk.Label(row, text=user["full_name"], font=(FONT, 11, "bold"), bg=who["bg"],
                 fg=INK).pack(side="left", padx=(0, 8))
        role_badge(row, user["role"]).pack(side="left")

        code_label = "รหัสนักศึกษา *" if user["role"] == "student" else "รหัสอาจารย์ / พนักงาน *"
        self.code_f = Field(body, code_label, accent=room_color)
        self.code_f.pack(fill="x", pady=(0, 10))
        self.phone_f = Field(body, "เบอร์โทรติดต่อ *", accent=room_color)
        self.phone_f.pack(fill="x", pady=(0, 10))
        hint = f"  (ห้องนี้จุได้ {capacity})" if capacity else ""
        self.att_f = Field(body, "จำนวนผู้เข้าใช้ห้อง *" + hint, accent=room_color)
        self.att_f.pack(fill="x", pady=(0, 10))

        tk.Label(body, text="วัตถุประสงค์ *", font=(FONT, 9, "bold"), bg=PANEL,
                 fg=MUTED).pack(anchor="w")
        box = tk.Frame(body, bg=BORDER, padx=1, pady=1)
        box.pack(fill="x", pady=(3, 16))
        self.purpose_text = tk.Text(box, width=40, height=3, font=(FONT, 11), relief="flat",
                                    bd=0, padx=8, pady=6, wrap="word")
        self.purpose_text.pack(fill="x")
        self.purpose_text.bind("<FocusIn>", lambda e: box.config(bg=room_color))
        self.purpose_text.bind("<FocusOut>", lambda e: box.config(bg=BORDER))

        button_row = tk.Frame(body, bg=PANEL)
        button_row.pack(fill="x")
        ColorButton(button_row, color=room_color, text="✔ ยืนยันการจอง",
                    command=self.on_confirm).pack(side="left", padx=(0, 8))
        tk.Button(button_row, text="ยกเลิก", relief="flat", bd=0, bg="#EDE6DA", fg=INK,
                  font=(FONT, 10), padx=14, pady=8, cursor="hand2",
                  command=self.destroy).pack(side="left")

        self.transient(parent)
        self.grab_set()
        self.code_f.focus()

    def on_confirm(self):
        def warn(msg):
            messagebox.showwarning("กรอกข้อมูลไม่ครบ", msg, parent=self)

        code = self.code_f.get().strip()
        phone = self.phone_f.get().strip()
        raw_att = self.att_f.get().strip()
        purpose = self.purpose_text.get("1.0", "end").strip()

        if not code:
            return warn("กรุณากรอกรหัสนักศึกษา / รหัสอาจารย์")
        if not phone:
            return warn("กรุณากรอกเบอร์โทรติดต่อ")
        digits = "".join(ch for ch in phone if ch.isdigit())
        if not set(phone) <= set("0123456789-+ ") or not 9 <= len(digits) <= 10:
            return warn("เบอร์โทรไม่ถูกต้อง ต้องเป็นตัวเลข 9-10 หลัก เช่น 0812345678")
        if not raw_att:
            return warn("กรุณากรอกจำนวนผู้เข้าใช้ห้อง")
        if not raw_att.isdigit() or int(raw_att) <= 0:
            return warn("จำนวนผู้เข้าใช้ต้องเป็นตัวเลขจำนวนเต็มมากกว่า 0")
        attendees = int(raw_att)
        if self.capacity and attendees > self.capacity:
            return warn(f"ห้องนี้จุได้สูงสุด {self.capacity} คน")
        if not purpose:
            return warn("กรุณากรอกวัตถุประสงค์การใช้ห้อง")

        self.result = {"purpose": purpose, "code": code, "phone": phone, "attendees": attendees}
        self.destroy()


