def _text(value):
    if isinstance(value, (bytes, bytearray)):
        return bytes(value).decode("utf-8", errors="replace")
    return value or ""


def load_reference_data():
    """โหลดห้อง อุปกรณ์ และคาบเวลาจากฐานข้อมูล"""
    conn = get_conn()
    try:
        cur = conn.cursor(dictionary=True)
        cur.execute(
            """
            SELECT r.room_id, r.room_name, r.building, r.capacity, r.color,
                   GROUP_CONCAT(
                       CONCAT(e.equipment_name, IF(re.quantity > 1, CONCAT(' x', re.quantity), ''))
                       ORDER BY e.equipment_name SEPARATOR ', '
                   ) AS equipment
            FROM rooms r
            LEFT JOIN room_equipment re ON re.room_id = r.room_id
            LEFT JOIN equipment e ON e.equipment_id = re.equipment_id
            GROUP BY r.room_id, r.room_name, r.building, r.capacity, r.color
            ORDER BY r.building, r.room_name
            """
        )
        rooms = [
            {
                "id": row["room_id"],
                "name": _text(row["room_name"]),
                "building": _text(row["building"]),
                "capacity": row["capacity"],
                "color": _text(row["color"]) or ACCENT,
                "equipment": _text(row["equipment"]),
            }
            for row in cur.fetchall()
        ]
        cur.execute("SELECT slot_id, slot_label FROM time_slots ORDER BY start_time")
        slots = [{"id": row["slot_id"], "label": _text(row["slot_label"])} for row in cur.fetchall()]
        cur.close()
    finally:
        conn.close()

    if rooms:
        ROOMS[:] = rooms
        ROOM_BY_ID.clear()
        ROOM_BY_ID.update({r["id"]: r for r in rooms})
    if slots:
        TIME_SLOTS[:] = slots


def init_db():
    load_reference_data()


# ----- บัญชีผู้ใช้ ---------------------------------------------------------
EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
PBKDF2_ROUNDS = 200_000
MIN_PASSWORD_LEN = 8


def hash_password(password):
    """เข้ารหัสรหัสผ่านด้วย PBKDF2-SHA256 + salt สุ่มใหม่ทุกครั้ง"""
    salt = os.urandom(16)
    digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, PBKDF2_ROUNDS)
    return f"pbkdf2_sha256${PBKDF2_ROUNDS}${salt.hex()}${digest.hex()}"


def verify_password(password, stored):
    try:
        algo, rounds, salt_hex, hash_hex = stored.split("$")
        if algo != "pbkdf2_sha256":
            return False
        digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"),
                                     bytes.fromhex(salt_hex), int(rounds))
    except (ValueError, AttributeError):
        return False
    return hmac.compare_digest(digest.hex(), hash_hex)


def create_user(role, first_name, last_name, email, password):
    """คืน (True, user_id) ถ้าสมัครสำเร็จ / (False, 'email' หรือ 'name') ถ้าซ้ำ"""
    conn = get_conn()
    try:
        cur = conn.cursor()
        try:
            cur.execute(
                """
                INSERT INTO users (role, first_name, last_name, email, password_hash)
                VALUES (%s, %s, %s, %s, %s)
                """,
                (role, first_name, last_name, email.lower(), hash_password(password)),
            )
            conn.commit()
            return True, cur.lastrowid
        except mysql.connector.IntegrityError as err:
            conn.rollback()
            if err.errno == 1062:
                return False, ("email" if "uq_user_email" in (err.msg or "") else "name")
            raise
        finally:
            cur.close()
    finally:
        conn.close()


def authenticate(identifier, password):
    """ล็อกอินด้วย 'ชื่อ นามสกุล' หรือ 'อีเมล' คืน dict ผู้ใช้ หรือ None ถ้าไม่ถูกต้อง"""
    ident = " ".join(identifier.split())
    conn = get_conn()
    try:
        cur = conn.cursor(dictionary=True)
        cur.execute(
            """
            SELECT user_id, role, first_name, last_name, email, password_hash
            FROM users
            WHERE email = %s OR CONCAT(first_name, ' ', last_name) = %s
            """,
            (ident.lower(), ident),
        )
        rows = cur.fetchall()
        cur.close()
    finally:
        conn.close()

    for row in rows:
        if verify_password(password, _text(row["password_hash"])):
            first, last = _text(row["first_name"]), _text(row["last_name"])
            return {
                "id": row["user_id"],
                "role": _text(row["role"]),
                "first_name": first,
                "last_name": last,
                "full_name": f"{first} {last}",
                "email": _text(row["email"]),
            }
    return None


