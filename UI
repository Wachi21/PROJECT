"""
KMITL Classroom Booking - Round 3/4
ปรับปรุง UI + validation + สถานะห้องว่างตามวันที่/เวลา + รายละเอียดห้อง
ติดตั้ง: pip install mysql-connector-python
สร้าง DB: CREATE DATABASE kmitl_classroom_booking CHARACTER SET utf8mb4;
แก้ DB_CONFIG ก่อนรัน
"""
import tkinter as tk
from tkinter import ttk, messagebox
from datetime import date
import mysql.connector
from mysql.connector import Error

DB_CONFIG = {"host": "localhost", "user": "root", "password": "", "database": "kmitl_classroom_booking"}
SLOTS = ["08:00 - 10:00", "10:00 - 12:00", "13:00 - 15:00", "15:00 - 17:00"]
SEED = [
    ("เรียนรวม 101", "อาคารเรียนรวม", 40, "โปรเจกเตอร์, กระดานไวท์บอร์ด"),
    ("LAB Computer 1", "อาคารปฏิบัติการ", 30, "คอมพิวเตอร์, โปรเจกเตอร์"),
    ("ประชุม 201", "อาคารวิศวกรรม", 20, "จอแสดงผล, กระดานไวท์บอร์ด"),
    ("ห้องสัมมนา 301", "อาคารวิศวกรรม", 60, "โปรเจกเตอร์, ไมโครโฟน, เครื่องเสียง"),
]


class DB:
    def connect(self): return mysql.connector.connect(**DB_CONFIG)

    def setup(self):
        c = self.connect(); q = c.cursor()
        q.execute("""CREATE TABLE IF NOT EXISTS rooms(
            id INT AUTO_INCREMENT PRIMARY KEY, name VARCHAR(100) UNIQUE NOT NULL,
            building VARCHAR(100) NOT NULL, capacity INT NOT NULL, equipment TEXT)""")
        q.execute("""CREATE TABLE IF NOT EXISTS bookings(
            id INT AUTO_INCREMENT PRIMARY KEY, room_id INT NOT NULL,
            booking_date DATE NOT NULL, time_slot VARCHAR(30) NOT NULL,
            booker_name VARCHAR(150) NOT NULL, attendee_count INT NOT NULL,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            UNIQUE KEY uq_room_date_slot(room_id,booking_date,time_slot),
            FOREIGN KEY(room_id) REFERENCES rooms(id))""")
        q.execute("SELECT COUNT(*) FROM rooms")
        if q.fetchone()[0] == 0:
            q.executemany("INSERT INTO rooms(name,building,capacity,equipment) VALUES(%s,%s,%s,%s)", SEED)
        c.commit(); q.close(); c.close()

    def rooms(self):
        c=self.connect(); q=c.cursor(dictionary=True); q.execute("SELECT * FROM rooms ORDER BY name")
        x=q.fetchall(); q.close(); c.close(); return x

    def booked_room_ids(self, day, slot):
        c=self.connect(); q=c.cursor()
        q.execute("SELECT room_id FROM bookings WHERE booking_date=%s AND time_slot=%s",(day,slot))
        x={r[0] for r in q.fetchall()}; q.close(); c.close(); return x

    def add_booking(self, room_id, day, slot, name, count):
        c=self.connect(); q=c.cursor()
        try:
            q.execute("INSERT INTO bookings(room_id,booking_date,time_slot,booker_name,attendee_count) VALUES(%s,%s,%s,%s,%s)",
                      (room_id,day,slot,name,count))
            c.commit(); return True
        except mysql.connector.IntegrityError:
            c.rollback(); return False
        finally: q.close(); c.close()

    def list_bookings(self):
        c=self.connect(); q=c.cursor(dictionary=True)
        q.execute("""SELECT b.id,r.name room,b.booking_date,b.time_slot,b.booker_name,b.attendee_count
                     FROM bookings b JOIN rooms r ON r.id=b.room_id ORDER BY b.booking_date DESC,b.time_slot""")
        x=q.fetchall(); q.close(); c.close(); return x

    def delete_booking(self, booking_id):
        c=self.connect(); q=c.cursor(); q.execute("DELETE FROM bookings WHERE id=%s",(booking_id,))
        n=q.rowcount; c.commit(); q.close(); c.close(); return n > 0


class App:
    def __init__(self, root):
        self.root=root; root.title("KMITL Classroom Booking - Round 3")
        root.geometry("1120x720"); root.minsize(950,620); root.configure(bg="#F3F6FB")
        self.db=DB(); self.rooms=[]; self.by_name={}; self.chosen=None
        self.day=tk.StringVar(value=date.today().isoformat()); self.slot=tk.StringVar(value=SLOTS[0])
        self.name=tk.StringVar(); self.count=tk.StringVar(value="1")
        self.styles(); self.layout(); self.load()

    def styles(self):
        s=ttk.Style()
        try: s.theme_use("clam")
        except tk.TclError: pass
        s.configure("Treeview",font=("Tahoma",10),rowheight=32)
        s.configure("Treeview.Heading",font=("Tahoma",10,"bold"),background="#E7EDF7")

    def layout(self):
        tk.Label(self.root,text="KMITL CLASSROOM BOOKING",font=("Tahoma",20,"bold"),
                 bg="#173B70",fg="white",pady=17).pack(fill="x")
        tk.Label(self.root,text="ระบบจองห้องเรียนและห้องปฏิบัติการ | Round 3/4",
                 bg="#173B70",fg="#DCE8FA",font=("Tahoma",10)).pack(fill="x")
        tabs=ttk.Notebook(self.root); tabs.pack(fill="both",expand=True,padx=18,pady=18)
        self.book_tab=tk.Frame(tabs,bg="#F3F6FB",padx=16,pady=16)
        self.list_tab=tk.Frame(tabs,bg="#F3F6FB",padx=16,pady=16)
        tabs.add(self.book_tab,text="จองห้องเรียน"); tabs.add(self.list_tab,text="ประวัติการจอง")

        left=tk.Frame(self.book_tab,bg="white",padx=15,pady=15)
        left.pack(side="left",fill="both",expand=True,padx=(0,12))
        tk.Label(left,text="ห้องเรียนทั้งหมด",font=("Tahoma",14,"bold"),bg="white").pack(anchor="w")
        self.room_tree=ttk.Treeview(left,columns=("building","capacity","status"),show="tree headings")
        for col,title,w in [("#0","ห้อง",180),("building","อาคาร",140),("capacity","ความจุ",75),("status","สถานะ",100)]:
            self.room_tree.heading(col,text=title); self.room_tree.column(col,width=w,anchor="center")
        self.room_tree.pack(fill="both",expand=True,pady=12)
        self.room_tree.bind("<<TreeviewSelect>>",self.select_room)

        right=tk.Frame(self.book_tab,bg="white",width=340,padx=18,pady=16)
        right.pack(side="right",fill="y"); right.pack_propagate(False)
        tk.Label(right,text="ข้อมูลการจอง",font=("Tahoma",14,"bold"),bg="white").pack(anchor="w",pady=(0,12))
        self.detail=tk.Label(right,text="เลือกห้องเพื่อดูรายละเอียด",bg="white",fg="#526176",
                             justify="left",wraplength=290,font=("Tahoma",10))
        self.detail.pack(anchor="w",pady=(0,15))
        self.field(right,"ชื่อผู้จอง"); ttk.Entry(right,textvariable=self.name).pack(fill="x",pady=(0,10))
        self.field(right,"วันที่ (YYYY-MM-DD)"); ttk.Entry(right,textvariable=self.day).pack(fill="x",pady=(0,10))
        self.day.trace_add("write",lambda *_: self.refresh_rooms())
        self.field(right,"ช่วงเวลา")
        cb=ttk.Combobox(right,textvariable=self.slot,values=SLOTS,state="readonly")
        cb.pack(fill="x",pady=(0,10)); cb.bind("<<ComboboxSelected>>",lambda e:self.refresh_rooms())
        self.field(right,"จำนวนผู้เข้าใช้"); ttk.Entry(right,textvariable=self.count).pack(fill="x",pady=(0,15))
        tk.Button(right,text="ยืนยันการจอง",command=self.book,bg="#2457A6",fg="white",
                  relief="flat",font=("Tahoma",11,"bold"),pady=9).pack(fill="x")
        tk.Label(right,text="* สถานะห้องอัปเดตตามวันที่และช่วงเวลาที่เลือก",
                 bg="white",fg="#7B8798",wraplength=285,font=("Tahoma",9)).pack(pady=12)

        cols=("id","room","day","slot","name","count")
        self.history=ttk.Treeview(self.list_tab,columns=cols,show="headings")
        for col,title,w in zip(cols,["รหัส","ห้อง","วันที่","เวลา","ผู้จอง","จำนวนคน"],[55,170,120,130,180,90]):
            self.history.heading(col,text=title); self.history.column(col,width=w,anchor="center")
        self.history.pack(fill="both",expand=True)
        bar=tk.Frame(self.list_tab,bg="#F3F6FB"); bar.pack(fill="x",pady=12)
        tk.Button(bar,text="รีเฟรช",command=self.refresh_history).pack(side="right",padx=5)
        tk.Button(bar,text="ยกเลิกรายการที่เลือก",command=self.cancel,bg="#B42318",fg="white",
                  relief="flat",padx=12,pady=6).pack(side="right")

    def field(self,parent,text):
        tk.Label(parent,text=text,font=("Tahoma",10,"bold"),bg="white",fg="#34445B").pack(anchor="w",pady=(4,5))

    def load(self):
        try:
            self.db.setup(); self.rooms=self.db.rooms(); self.by_name={r["name"]:r for r in self.rooms}
            self.refresh_rooms(); self.refresh_history()
        except Error as e: messagebox.showerror("Database error",f"{e}\nตรวจสอบ MySQL และ DB_CONFIG")

    def refresh_rooms(self):
        if not hasattr(self,"room_tree") or not self.rooms: return
        try:
            day=date.fromisoformat(self.day.get().strip()).isoformat()
            booked=self.db.booked_room_ids(day,self.slot.get())
        except (ValueError,Error):
            booked=set()
        for i in self.room_tree.get_children(): self.room_tree.delete(i)
        for r in self.rooms:
            status="ไม่ว่าง" if r["id"] in booked else "ว่าง"
            self.room_tree.insert("","end",iid=str(r["id"]),text=r["name"],
                                  values=(r["building"],f'{r["capacity"]} คน',status))
        if self.chosen:
            self.select_room()

    def select_room(self,_=None):
        sel=self.room_tree.selection()
        if sel: self.chosen=next((r for r in self.rooms if r["id"]==int(sel[0])),None)
        if self.chosen:
            r=self.chosen
            self.detail.config(text=f'ห้อง: {r["name"]}\nอาคาร: {r["building"]}\nความจุ: {r["capacity"]} คน\nอุปกรณ์: {r["equipment"]}')

    def book(self):
        try:
            if not self.chosen: raise ValueError("กรุณาเลือกห้อง")
            name=self.name.get().strip()
            if len(name)<2: raise ValueError("กรุณากรอกชื่อผู้จองอย่างน้อย 2 ตัวอักษร")
            day=date.fromisoformat(self.day.get().strip())
            if day<date.today(): raise ValueError("ไม่สามารถจองวันที่ผ่านมาแล้ว")
            count=int(self.count.get())
            if not 1<=count<=self.chosen["capacity"]: raise ValueError(f'จำนวนคนต้องอยู่ระหว่าง 1 ถึง {self.chosen["capacity"]}')
            if self.chosen["id"] in self.db.booked_room_ids(day,self.slot.get()):
                raise ValueError("ห้องนี้ถูกจองในช่วงเวลาที่เลือกแล้ว")
            if not self.db.add_booking(self.chosen["id"],day,self.slot.get(),name,count):
                raise ValueError("มีผู้จองห้องนี้ในช่วงเวลาเดียวกันแล้ว")
            messagebox.showinfo("สำเร็จ","บันทึกการจองเรียบร้อย")
            self.refresh_rooms(); self.refresh_history()
        except ValueError as e: messagebox.showwarning("ตรวจสอบข้อมูล",str(e))
        except Error as e: messagebox.showerror("Database error",str(e))

    def refresh_history(self):
        if not hasattr(self,"history"): return
        for i in self.history.get_children(): self.history.delete(i)
        try:
            for b in self.db.list_bookings():
                self.history.insert("","end",iid=str(b["id"]),values=(b["id"],b["room"],b["booking_date"],
                    b["time_slot"],b["booker_name"],b["attendee_count"]))
        except Error as e: messagebox.showerror("Database error",str(e))

    def cancel(self):
        sel=self.history.selection()
        if not sel: messagebox.showwarning("แจ้งเตือน","กรุณาเลือกรายการ"); return
        if messagebox.askyesno("ยืนยัน","ต้องการยกเลิกการจองนี้หรือไม่?"):
            try:
                self.db.delete_booking(int(sel[0])); self.refresh_history(); self.refresh_rooms()
                messagebox.showinfo("สำเร็จ","ยกเลิกรายการแล้ว")
            except Error as e: messagebox.showerror("Database error",str(e))


if __name__=="__main__":
    root=tk.Tk(); App(root); root.mainloop()

