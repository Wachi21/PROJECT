        self.on_logout = on_logout
        self.dates, self.date_labels = date_options()
        self.selected_room_id = ROOMS[0]["id"]
        self.selected_date_idx = 0

        self._build_header()
        self._build_room_rail()
        self._build_date_strip()
        self._build_info_card()
        self._build_slot_list()
        self._build_footer()
        self.refresh()

    @property
    def top(self):
        return self.winfo_toplevel()

    # ----- Header ---------------------------------------------------------
    def _build_header(self):
        canvas = tk.Canvas(self, height=86, highlightthickness=0, bd=0)
        canvas.pack(fill="x")
        self.logout_btn = tk.Button(
            canvas, text="🚪 ออกจากระบบ", font=(FONT, 9, "bold"), bg="white", fg=ACCENT_DARK,
            activebackground="#FBE3E9", relief="flat", bd=0, padx=12, pady=6, cursor="hand2",
            command=self.on_logout)
        label, icon, color = ROLE_INFO[self.user["role"]]

        def draw(event=None):
            canvas.delete("grad")
            w = canvas.winfo_width() or 980
            draw_gradient(canvas, w, 86, ACCENT_DARK, ACCENT_LIGHT)
            draw_logo(canvas, 18, 17)
            canvas.create_text(86, 32, anchor="w", text="KMITL Classroom Booking",
                               fill="white", font=(FONT, 18, "bold"), tags="grad")
            canvas.create_text(86, 58, anchor="w",
                               text="จองห้องเรียนออนไลน์ · เลือกห้อง เลือกเวลา จองได้ทันที",
                               fill="#FBE3E9", font=(FONT, 10), tags="grad")
            bw = self.logout_btn.winfo_reqwidth()
            canvas.create_window(w - 18, 43, window=self.logout_btn, anchor="e", tags="grad")
            cx = w - 18 - bw - 18 - 21
            canvas.create_oval(cx - 21, 22, cx + 21, 64, fill=color, outline="white", width=2,
                               tags="grad")
            canvas.create_text(cx, 43, text=self.user["first_name"][:1], fill="white",
                               font=(FONT, 15, "bold"), tags="grad")
            canvas.create_text(cx - 30, 34, anchor="e", text=self.user["full_name"], fill="white",
                               font=(FONT, 11, "bold"), tags="grad")
            canvas.create_text(cx - 30, 54, anchor="e", text=f"{icon} {label}", fill="#FBE3E9",
                               font=(FONT, 9), tags="grad")
        canvas.bind("<Configure>", draw)

    # ----- เลือกห้อง: การ์ดแต่ละห้อง ---------------------------------------
    def _build_room_rail(self):
        wrap = tk.Frame(self, bg=BG)
        wrap.pack(fill="x", padx=20, pady=(14, 4))
        tk.Label(wrap, text="ห้องเรียน", font=(FONT, 9, "bold"), bg=BG, fg=MUTED).pack(anchor="w")

        grid = tk.Frame(wrap, bg=BG)
        grid.pack(fill="x", pady=(4, 0))
        self.room_cards = {}
        for i, room in enumerate(ROOMS):
            r, c = divmod(i, ROOM_COLS)
            grid.columnconfigure(c, weight=1, uniform="room")
            card = tk.Frame(grid, bg=PANEL, highlightthickness=1, cursor="hand2")
            card.grid(row=r, column=c, sticky="nsew", padx=3, pady=3)
            stripe = tk.Frame(card, height=4, bg=room["color"])
            stripe.keep_color = True
            stripe.pack(fill="x")
            name = tk.Label(card, text=room["name"], font=(FONT, 10, "bold"), bg=PANEL, fg=INK,
                            anchor="w")
            name.kind = "title"
            name.pack(fill="x", padx=10, pady=(6, 0))
            cap = f"👥 {room['capacity']} ที่นั่ง" if room.get("capacity") else "ห้องเรียน"
            sub = tk.Label(card, text=cap, font=(FONT, 8), bg=PANEL, fg=MUTED, anchor="w")
            sub.kind = "sub"
            sub.pack(fill="x", padx=10, pady=(0, 7))
            bind_click(card, lambda rid=room["id"]: self.select_room(rid))
            self.room_cards[room["id"]] = card

    def select_room(self, room_id):
        self.selected_room_id = room_id
        self.refresh()

    # ----- เลือกวันที่ ------------------------------------------------------
    def _build_date_strip(self):
        wrap = tk.Frame(self, bg=BG)
        wrap.pack(fill="x", padx=20, pady=(8, 4))
        tk.Label(wrap, text="วันที่", font=(FONT, 9, "bold"), bg=BG, fg=MUTED).pack(anchor="w")

        outer = tk.Frame(wrap, bg=BG)
        outer.pack(fill="x", pady=(4, 0))
        canvas = tk.Canvas(outer, height=54, bg=BG, highlightthickness=0)
        hbar = ttk.Scrollbar(outer, orient="horizontal", command=canvas.xview)
        strip = tk.Frame(canvas, bg=BG)
        strip.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.create_window((0, 0), window=strip, anchor="nw")
        canvas.configure(xscrollcommand=hbar.set)
        canvas.pack(fill="x")
        hbar.pack(fill="x")

        self.date_buttons = []
        for idx, label in enumerate(self.date_labels):
            btn = tk.Button(strip, text=label, font=(FONT, 9, "bold"), relief="flat", bd=0,
                            padx=12, pady=5, cursor="hand2", width=7,
                            command=lambda i=idx: self.select_date(i))
            btn.pack(side="left", padx=3)
            self.date_buttons.append(btn)

    def select_date(self, idx):
        self.selected_date_idx = idx
        self.refresh()

    # ----- การ์ดสรุปห้อง ----------------------------------------------------
    def _build_info_card(self):
        self.info = tk.Frame(self, bg=PANEL, highlightthickness=1, highlightbackground=BORDER)
        self.info.pack(fill="x", padx=20, pady=(8, 4))
        self.info_stripe = tk.Frame(self.info, width=6)
        self.info_stripe.pack(side="left", fill="y")

        left = tk.Frame(self.info, bg=PANEL)
        left.pack(side="left", fill="both", expand=True, padx=14, pady=10)
        self.info_title = tk.Label(left, text="", font=(FONT, 12, "bold"), bg=PANEL, fg=INK,
                                   anchor="w")
        self.info_title.pack(fill="x")
        self.info_sub = tk.Label(left, text="", font=(FONT, 9), bg=PANEL, fg=MUTED, anchor="w",
                                 justify="left", wraplength=560)
        self.info_sub.pack(fill="x", pady=(2, 0))

        right = tk.Frame(self.info, bg=PANEL)
        right.pack(side="right", padx=14)
        self.chip_free = tk.Label(right, font=(FONT, 9, "bold"), bg=FREE_BG, fg=FREE_FG,
                                  padx=10, pady=4)
        self.chip_free.pack(side="left", padx=(0, 6))
        self.chip_booked = tk.Label(right, font=(FONT, 9, "bold"), bg=BOOKED_BG, fg=BOOKED_FG,
                                    padx=10, pady=4)
        self.chip_booked.pack(side="left")

    # ----- รายการคาบเวลา ----------------------------------------------------
    def _build_slot_list(self):
        outer = tk.Frame(self, bg=BG)
        outer.pack(fill="both", expand=True, padx=20, pady=(6, 4))
        canvas = tk.Canvas(outer, bg=BG, highlightthickness=0)
        vbar = ttk.Scrollbar(outer, orient="vertical", command=canvas.yview)
        self.list_frame = tk.Frame(canvas, bg=BG)
        win = canvas.create_window((0, 0), window=self.list_frame, anchor="nw")
        self.list_frame.bind("<Configure>",
                             lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<Configure>", lambda e: canvas.itemconfig(win, width=e.width))
        canvas.configure(yscrollcommand=vbar.set)
        canvas.pack(side="left", fill="both", expand=True)
        vbar.pack(side="right", fill="y")
        bind_mousewheel(canvas)

    def _build_footer(self):
        bar = tk.Frame(self, bg=BG)
        bar.pack(fill="x", padx=20, pady=(2, 14))
        tk.Label(bar, text="🔒 ยกเลิกได้เฉพาะการจองของคุณเอง", font=(FONT, 9), bg=BG,
                 fg=MUTED).pack(side="left")
        ColorButton(bar, color="#4B3F72", text="📜 ประวัติทั้งหมด", command=self.open_history,
                    font=(FONT, 9, "bold"), padx=12, pady=6).pack(side="right")
        ColorButton(bar, color=GOLD, text="📌 การจองของฉัน", command=self.open_my_bookings,
                    font=(FONT, 9, "bold"), padx=12, pady=6).pack(side="right", padx=(0, 8))

    # ----- วาดข้อมูลใหม่ -----------------------------------------------------
    def refresh(self):
        room = ROOM_BY_ID[self.selected_room_id]
        iso_date = self.dates[self.selected_date_idx].isoformat()
        try:
            bookings = fetch_bookings(self.selected_room_id, iso_date)
        except Exception as err:
            self.show_db_error(err)
            bookings = {}

        for rid, card in self.room_cards.items():
            color = ROOM_BY_ID[rid]["color"]
            if rid == self.selected_room_id:
                card.config(highlightbackground=color)
                recolor(card, bg=color, fg_map={"title": "white", "sub": "#FBE3E9"})
            else:
                card.config(highlightbackground=BORDER)
                recolor(card, bg=PANEL, fg_map={"title": INK, "sub": MUTED})

        for idx, btn in enumerate(self.date_buttons):
            if idx == self.selected_date_idx:
                btn.config(bg=GOLD, fg="white", activebackground=GOLD)
            else:
                btn.config(bg="#F1E7D8", fg=INK, activebackground="#E8DAC5")

        for widget in self.list_frame.winfo_children():
            widget.destroy()
        free_count = 0
        for slot in TIME_SLOTS:
            booking = bookings.get(slot["id"])
            self._add_slot_row(slot, booking, room["color"])
            if not booking:
                free_count += 1

        self.info_stripe.config(bg=room["color"])
        self.info_title.config(text=f"📍 {room['name']} · {room['building']}")
        parts = []
        if room.get("capacity"):
            parts.append(f"👥 จุ {room['capacity']} ที่นั่ง")
        if room.get("equipment"):
            parts.append(f"🛠 {room['equipment']}")
        self.info_sub.config(text="   ".join(parts) if parts else "ยังไม่มีข้อมูลอุปกรณ์")
        self.chip_free.config(text=f"🟢 ว่าง {free_count} คาบ")
        self.chip_booked.config(text=f"🟠 จองแล้ว {len(TIME_SLOTS) - free_count} คาบ")

    def _add_slot_row(self, slot, booking, room_color):
        is_booked = booking is not None
        mine = is_booked and booking.get("user_id") == self.user["id"]
        row_bg = BOOKED_BG if is_booked else FREE_BG

        card = tk.Frame(self.list_frame, bg=row_bg, padx=14, pady=10, highlightthickness=1,
                        highlightbackground=mix(room_color, 0.6) if is_booked else "#CFE8D9")
        card.pack(fill="x", pady=4)

        tk.Frame(card, bg=room_color if is_booked else "#9CCFB2", width=5).pack(
            side="left", fill="y", padx=(0, 12))

        info = tk.Frame(card, bg=row_bg)
        info.pack(side="left", fill="both", expand=True)
        top = tk.Frame(info, bg=row_bg)
        top.pack(fill="x", anchor="w")
        tk.Label(top, text=slot["label"], font=(FONT, 12, "bold"), bg=row_bg,
                 fg=INK).pack(side="left")
        tk.Label(top, text="จองแล้ว" if is_booked else "ว่าง", font=(FONT, 8, "bold"),
                 bg=BOOKED_FG if is_booked else FREE_FG, fg="white", padx=8,
                 pady=1).pack(side="left", padx=(10, 0))
        if mine:
            tk.Label(top, text="ของคุณ", font=(FONT, 8, "bold"), bg=ACCENT, fg="white",
                     padx=8, pady=1).pack(side="left", padx=(6, 0))

        if is_booked:
            role = ROLE_INFO.get(booking.get("booker_role"))
            who = booking["booker_name"] + (f"  ({role[1]} {role[0]})" if role else "")
            if booking["purpose"]:
                who += f" — {booking['purpose']}"
            lines = [who]
            if mine:     # เบอร์โทร/รหัส แสดงเฉพาะเจ้าของการจอง
                extras = []
                if booking.get("booker_code"):
                    extras.append(f"🪪 {booking['booker_code']}")
                if booking.get("attendees"):
                    extras.append(f"👥 {booking['attendees']} คน")
                if booking.get("phone"):
                    extras.append(f"📞 {booking['phone']}")
                if extras:
                    lines.append("   ".join(extras))
            tk.Label(info, text="\n".join(lines), font=(FONT, 9), bg=row_bg, fg=MUTED,
                     anchor="w", justify="left", wraplength=520).pack(fill="x", anchor="w",
                                                                      pady=(3, 0))

        action = tk.Frame(card, bg=row_bg)
        action.pack(side="right")
        if is_booked and mine:
            ColorButton(action, color=DANGER, text="✖ ยกเลิกการจอง", padx=12, pady=6,
                        font=(FONT, 9, "bold"),
                        command=lambda b=booking: self.cancel_slot(b)).pack()
        elif is_booked:
            tk.Label(action, text="🔒 จองโดยผู้อื่น", font=(FONT, 9), bg=row_bg,
                     fg=MUTED).pack()
        else:
            ColorButton(action, color=room_color, text="จองคาบนี้", padx=14, pady=6,
                        font=(FONT, 9, "bold"),
                        command=lambda s=slot: self.book_slot(s, room_color)).pack()

    # ----- การกระทำ -----------------------------------------------------------
    def show_db_error(self, err):
        messagebox.showerror("ฐานข้อมูลมีปัญหา", describe_db_error(err))

    def book_slot(self, slot, room_color):
        room = ROOM_BY_ID[self.selected_room_id]
        dialog = BookingDialog(self.top, self.user, slot["label"], room_color,
                               room.get("capacity"))
        self.top.wait_window(dialog)
        if not dialog.result:
            return
        data = dialog.result
        iso_date = self.dates[self.selected_date_idx].isoformat()
        try:
            ok = insert_booking(
                self.selected_room_id, iso_date, slot["id"], self.user["id"],
                self.user["full_name"], data["purpose"],
                code=data["code"], phone=data["phone"], attendees=data["attendees"])
        except Exception as err:
            self.show_db_error(err)
            return
        if not ok:
            messagebox.showwarning("จองไม่สำเร็จ", "คาบเวลานี้เพิ่งถูกจองไปแล้ว")
        self.refresh()

    def cancel_slot(self, booking):
        if not messagebox.askyesno("ยืนยัน", "ยกเลิกการจองคาบนี้ใช่หรือไม่?"):
            return
        try:
            deleted = delete_booking(booking["id"], self.user["id"])
        except Exception as err:
            self.show_db_error(err)
            return
        if not deleted:
            messagebox.showwarning("ยกเลิกไม่ได้", "ไม่พบการจองนี้ หรือไม่ใช่การจองของคุณ")
        self.refresh()

    def open_history(self):
        try:
            HistoryWindow(self.top)
        except Exception as err:
            self.show_db_error(err)

    def open_my_bookings(self):
        try:
            MyBookingsWindow(self.top, self.user, on_change=self.refresh)
        except Exception as err:
            self.show_db_error(err)


