class ColorButton(tk.Button):
    """ปุ่มสี มี hover"""
    def __init__(self, parent, color, hover_color=None, fg="white", **kwargs):
        self.base_color = color
        self.hover_color = hover_color or mix(color, 0.15)
        kwargs.setdefault("font", (FONT, 10, "bold"))
        kwargs.setdefault("padx", 16)
        kwargs.setdefault("pady", 8)
        super().__init__(
            parent, bg=color, fg=fg, activebackground=self.hover_color,
            activeforeground=fg, relief="flat", bd=0, cursor="hand2", **kwargs
        )
        self.bind("<Enter>", lambda e: self.config(bg=self.hover_color))
        self.bind("<Leave>", lambda e: self.config(bg=self.base_color))


class Field(tk.Frame):
    """ช่องกรอกข้อมูลพร้อมป้ายชื่อ ขอบเปลี่ยนสีเมื่อโฟกัส และปุ่ม 👁 สำหรับช่องรหัสผ่าน"""
    def __init__(self, parent, label, accent=ACCENT, secret=False, bg=PANEL):
        super().__init__(parent, bg=bg)
        tk.Label(self, text=label, font=(FONT, 9, "bold"), bg=bg, fg=MUTED).pack(anchor="w")
        self.box = tk.Frame(self, bg=BORDER, padx=1, pady=1)
        self.box.pack(fill="x", pady=(3, 0))
        inner = tk.Frame(self.box, bg="white")
        inner.pack(fill="x")

        self.entry = tk.Entry(inner, font=(FONT, 11), relief="flat", bd=0, bg="white",
                              fg=INK, insertbackground=INK, show="•" if secret else "")
        if secret:
            self._hidden = True
            eye = tk.Label(inner, text="👁", bg="white", fg=MUTED, cursor="hand2",
                           font=(FONT, 10))
            eye.pack(side="right", padx=(0, 8))
            eye.bind("<Button-1>", lambda e: self._toggle())
        self.entry.pack(side="left", fill="x", expand=True, padx=8, ipady=6)
        self.entry.bind("<FocusIn>", lambda e: self.box.config(bg=accent))
        self.entry.bind("<FocusOut>", lambda e: self.box.config(bg=BORDER))

    def _toggle(self):
        self._hidden = not self._hidden
        self.entry.config(show="•" if self._hidden else "")

    def get(self):
        return self.entry.get()

    def set(self, value):
        self.entry.delete(0, "end")
        self.entry.insert(0, value)

    def clear(self):
        self.entry.delete(0, "end")

    def focus(self):
        self.entry.focus_set()


