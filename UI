"""
KMITL Classroom Booking - Round 2/4
เพิ่ม MySQL: จองห้อง, ป้องกันเวลาซ้ำ, ยกเลิก, ดูประวัติ
ติดตั้ง: pip install mysql-connector-python
สร้างฐานข้อมูลก่อน: CREATE DATABASE kmitl_classroom_booking CHARACTER SET utf8mb4;
แก้ DB_CONFIG ให้ตรงกับเครื่อง แล้วรัน python round2_booking.py
"""
import tkinter as tk
from tkinter import ttk, messagebox
from datetime import date
import mysql.connector
from mysql.connector import Error

DB_CONFIG = {"host": "localhost", "user": "root", "password": "", "database": "kmitl_classroom_booking"}
TIME_SLOTS = ["08:00 - 10:00", "10:00 - 12:00", "13:00 - 15:00", "15:00 - 17:00"]
SEED_ROOMS = [
    ("เรียนรวม 101", "อาคารเรียนรวม", 40, "โปรเจกเตอร์, กระดานไวท์บอร์ด"),
    ("LAB Computer 1", "อาคารปฏิบัติการ", 30, "คอมพิวเตอร์, โปรเจกเตอร์"),
    ("ประชุม 201", "อาคารวิศวกรรม", 20, "จอแสดงผล, กระดานไวท์บอร์ด"),
]


class Database:
    def connect(self):
        return mysql.connector.connect(**DB_CONFIG)

    def initialize(self):
        conn = self.connect()
        cur = conn.cursor()
        cur.execute("""CREATE TABLE IF NOT EXISTS rooms (
            id INT AUTO_INCREMENT PRIMARY KEY, name VARCHAR(100) NOT NULL UNIQUE,
            building VARCHAR(100) NOT NULL, capacity INT NOT NULL, equipment TEXT)""")
        cur.execute("""CREATE TABLE IF NOT EXISTS bookings (
            id INT AUTO_INCREMENT PRIMARY KEY, room_id INT NOT NULL,
            booking_date DATE NOT NULL, time_slot VARCHAR(30) NOT NULL,
            booker_name VARCHAR(150) NOT NULL, attendee_count INT NOT NULL DEFAULT 1,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            CONSTRAINT fk_booking_room FOREIGN KEY (room_id) REFERENCES rooms(id),
            CONSTRAINT uq_room_slot UNIQUE (room_id, booking_date, time_slot))""")
        cur.execute("SELECT COUNT(*) FROM rooms")
        if cur.fetchone()[0] == 0:
            cur.executemany("INSERT INTO rooms(name,building,capacity,equipment) VALUES(%s,%s,%s,%s)", SEED_ROOMS)
        conn.commit()
        cur.close()
        conn.close()

    def rooms(self):
        conn = self.connect()
        cur = conn.cursor(dictionary=True)
        cur.execute("SELECT * FROM rooms ORDER BY name")
        rows = cur.fetchall()
        cur.close()
        conn.close()
        return rows

    def create_booking(self, room_id, booking_date, slot, name, attendees):
        conn = self.connect()
        cur = conn.cursor()
        try:
            cur.execute("""INSERT INTO bookings(room_id,booking_date,time_slot,booker_name,attendee_count)
                           VALUES(%s,%s,%s,%s,%s)""", (room_id, booking_date, slot, name, attendees))
            conn.commit()
            return True, "บันทึกการจองเรียบร้อย"
        except mysql.connector.IntegrityError:
            conn.rollback()
            return False, "ช่วงเวลานี้มีผู้จองห้องแล้ว กรุณาเลือกเวลาอื่น"
        finally:
            cur.close()
            conn.close()

    def bookings(self):
        conn = self.connect()
        cur = conn.cursor(dictionary=True)
        cur.execute("""SELECT b.id, r.name AS room_name, b.booking_date, b.time_slot,
                              b.booker_name, b.attendee_count, b.created_at
                       FROM bookings b JOIN rooms r ON r.id=b.room_id
                       ORDER BY b.booking_date DESC, b.time_slot""")
        rows = cur.fetchall()
        cur.close()
        conn.close()
        return rows

    def cancel(self, booking_id):
        conn = self.connect()
        cur = conn.cursor()
        cur.execute("DELETE FROM bookings WHERE id=%s", (booking_id,))
        deleted = cur.rowcount
        conn.commit()
        cur.close()
        conn.close()
        return deleted > 0


class BookingApp:
    def __init__(self, root):
        self.root = root
        root.title("KMITL Classroom Booking - Round 2")
        root.geometry("1050x680")
        self.db = Database()
        self.rooms = []
        self.room_by_id = {}
        self.build_ui()
        self.initialize_data()

    def build_ui(self):
        tk.Label(self.root, text="KMITL CLASSROOM BOOKING | ROUND 2/4",
                 font=("Tahoma", 18, "bold"), bg="#173B70", fg="white", pady=18).pack(fill="x")
        tabs = ttk.Notebook(self.root)
        tabs.pack(fill="both", expand=True, padx=15, pady=15)
        self.book_tab = tk.Frame(tabs, padx=20, pady=20)
        self.history_tab = tk.Frame(tabs, padx=20, pady=20)
        tabs.add(self.book_tab, text="จองห้องเรียน")
        tabs.add(self.history_tab, text="รายการจองทั้งหมด")

        tk.Label(self.book_tab, text="ชื่อผู้จอง").grid(row=0, column=0, sticky="w", pady=7)
        self.name_var = tk.StringVar()
        ttk.Entry(self.book_tab, textvariable=self.name_var, width=38).grid(row=0, column=1, sticky="w")
        tk.Label(self.book_tab, text="เลือกห้อง").grid(row=1, column=0, sticky="w", pady=7)
        self.room_var = tk.StringVar()
        self.room_combo = ttk.Combobox(self.book_tab, textvariable=self.room_var, state="readonly", width=35)
        self.room_combo.grid(row=1, column=1, sticky="w")
        tk.Label(self.book_tab, text="วันที่ (YYYY-MM-DD)").grid(row=2, column=0, sticky="w", pady=7)
        self.date_var = tk.StringVar(value=date.today().isoformat())
        ttk.Entry(self.book_tab, textvariable=self.date_var, width=38).grid(row=2, column=1, sticky="w")
        tk.Label(self.book_tab, text="ช่วงเวลา").grid(row=3, column=0, sticky="w", pady=7)
        self.slot_var = tk.StringVar(value=TIME_SLOTS[0])
        ttk.Combobox(self.book_tab, textvariable=self.slot_var, values=TIME_SLOTS,
                     state="readonly", width=35).grid(row=3, column=1, sticky="w")
        tk.Label(self.book_tab, text="จำนวนผู้เข้าใช้").grid(row=4, column=0, sticky="w", pady=7)
        self.att_var = tk.StringVar(value="1")
        ttk.Entry(self.book_tab, textvariable=self.att_var, width=38).grid(row=4, column=1, sticky="w")
        tk.Button(self.book_tab, text="ยืนยันการจอง", command=self.book,
                  bg="#2457A6", fg="white", relief="flat", padx=18, pady=8).grid(row=5, column=1, sticky="w", pady=18)

        cols = ("id", "room", "date", "slot", "name", "attendees")
        self.history = ttk.Treeview(self.history_tab, columns=cols, show="headings")
        for col, title, width in zip(cols, ["รหัส", "ห้อง", "วันที่", "เวลา", "ผู้จอง", "จำนวนคน"],
                                     [60, 180, 120, 130, 180, 90]):
            self.history.heading(col, text=title)
            self.history.column(col, width=width, anchor="center")
        self.history.pack(fill="both", expand=True)
        tk.Button(self.history_tab, text="ยกเลิกรายการที่เลือก", command=self.cancel,
                  bg="#B42318", fg="white", relief="flat", padx=15, pady=7).pack(anchor="e", pady=12)
        tk.Button(self.history_tab, text="รีเฟรช", command=self.refresh_history).pack(anchor="e")

    def initialize_data(self):
        try:
            self.db.initialize()
            self.rooms = self.db.rooms()
            self.room_by_id = {r["name"]: r for r in self.rooms}
            self.room_combo["values"] = list(self.room_by_id)
            if self.rooms:
                self.room_var.set(self.rooms[0]["name"])
            self.refresh_history()
        except Error as exc:
            messagebox.showerror("เชื่อมต่อฐานข้อมูลไม่สำเร็จ",
                                 f"{exc}\n\nตรวจสอบ MySQL และ DB_CONFIG ก่อนเปิดโปรแกรม")

    def book(self):
        try:
            name = self.name_var.get().strip()
            if not name:
                raise ValueError("กรุณากรอกชื่อผู้จอง")
            room = self.room_by_id.get(self.room_var.get())
            if not room:
                raise ValueError("กรุณาเลือกห้อง")
            day = date.fromisoformat(self.date_var.get().strip())
            if day < date.today():
                raise ValueError("ไม่สามารถจองวันที่ผ่านมาแล้ว")
            attendees = int(self.att_var.get())
            if attendees < 1 or attendees > room["capacity"]:
                raise ValueError(f'จำนวนผู้เข้าใช้ต้องอยู่ระหว่าง 1 ถึง {room["capacity"]} คน')
            ok, msg = self.db.create_booking(room["id"], day, self.slot_var.get(), name, attendees)
            (messagebox.showinfo if ok else messagebox.showwarning)("ผลการจอง", msg)
            self.refresh_history()
        except ValueError as exc:
            messagebox.showwarning("ข้อมูลไม่ถูกต้อง", str(exc))
        except Error as exc:
            messagebox.showerror("Database error", str(exc))

    def refresh_history(self):
        for item in self.history.get_children():
            self.history.delete(item)
        try:
            for b in self.db.bookings():
                self.history.insert("", "end", iid=str(b["id"]),
                    values=(b["id"], b["room_name"], b["booking_date"], b["time_slot"],
                            b["booker_name"], b["attendee_count"]))
        except Error as exc:
            messagebox.showerror("Database error", str(exc))

    def cancel(self):
        selected = self.history.selection()
        if not selected:
            messagebox.showwarning("แจ้งเตือน", "เลือกรายการที่ต้องการยกเลิก")
            return
        if not messagebox.askyesno("ยืนยัน", "ต้องการยกเลิกรายการนี้หรือไม่?"):
            return
        try:
            if self.db.cancel(int(selected[0])):
                messagebox.showinfo("สำเร็จ", "ยกเลิกการจองแล้ว")
            self.refresh_history()
        except Error as exc:
            messagebox.showerror("Database error", str(exc))


if __name__ == "__main__":
    root = tk.Tk()
    BookingApp(root)
    root.mainloop()

