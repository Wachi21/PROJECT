class AuthScreen(tk.Frame):
    def __init__(self, parent, on_login):
        super().__init__(parent, bg=BG)
        self.on_login = on_login
        self.mode = "login"
        self.role = "student"

        self._build_side_panel()

        right = tk.Frame(self, bg=BG)
        right.pack(side="left", fill="both", expand=True)

        self.card = tk.Frame(right, bg=PANEL, highlightthickness=1, highlightbackground=BORDER,
                             padx=34, pady=26)
        self.card.place(relx=0.5, rely=0.5, anchor="center")
        self._build_card()

    # ----- แผงซ้าย (กราเดียนต์ + จุดเด่นของแอป) ---------------------------
    def _build_side_panel(self):
        canvas = tk.Canvas(self, width=340, highlightthickness=0, bd=0)
        canvas.pack(side="left", fill="y")

        def draw(event=None):
            canvas.delete("grad")
            h = canvas.winfo_height() or 700
            draw_gradient(canvas, 340, h, ACCENT_DARK, ACCENT_LIGHT, vertical=True)
            draw_logo(canvas, 36, 40)
            canvas.create_text(36, 124, anchor="nw", text="KMITL\nClassroom\nBooking",
                               fill="white", font=(FONT, 26, "bold"), tags="grad")
            canvas.create_text(36, 270, anchor="nw",
                               text="จองห้องเรียนออนไลน์\nเลือกห้อง เลือกเวลา จองได้ทันที",
                               fill="#FBE3E9", font=(FONT, 11), tags="grad")
            perks = ["🗓  ดูห้องว่างล่วงหน้า 14 วัน", "🔒  จองและยกเลิกได้เฉพาะของตัวเอง",
                     "📌  ดูการจองของฉันได้ในที่เดียว"]
            for i, text in enumerate(perks):
                canvas.create_text(36, max(h - 150, 340) + i * 34, anchor="nw", text=text,
                                   fill="white", font=(FONT, 10), tags="grad")
        canvas.bind("<Configure>", draw)

    # ----- การ์ดฟอร์ม -----------------------------------------------------
    def _build_card(self):
        for w in self.card.winfo_children():
            w.destroy()

        title = "ยินดีต้อนรับกลับมา 👋" if self.mode == "login" else "สร้างบัญชีใหม่ ✨"
        sub = ("เข้าสู่ระบบด้วยชื่อ-นามสกุล หรืออีเมล" if self.mode == "login"
               else "สมัครสมาชิกก่อน แล้วจึงเข้าจองห้องได้")
        tk.Label(self.card, text=title, font=(FONT, 17, "bold"), bg=PANEL, fg=INK).pack(anchor="w")
        tk.Label(self.card, text=sub, font=(FONT, 9), bg=PANEL, fg=MUTED).pack(anchor="w", pady=(2, 14))

        # แท็บ
        tabs = tk.Frame(self.card, bg=PANEL)
        tabs.pack(fill="x", pady=(0, 16))
        for key, text in (("login", "เข้าสู่ระบบ"), ("register", "สมัครสมาชิก")):
            active = key == self.mode
            col = tk.Frame(tabs, bg=PANEL)
            col.pack(side="left", fill="x", expand=True)
            lbl = tk.Label(col, text=text, font=(FONT, 10, "bold"), bg=PANEL,
                           fg=ACCENT if active else MUTED, cursor="hand2", pady=6)
            lbl.pack(fill="x")
            tk.Frame(col, height=3, bg=ACCENT if active else BORDER).pack(fill="x")
            lbl.bind("<Button-1>", lambda e, k=key: self.switch(k))

        self.form = tk.Frame(self.card, bg=PANEL, width=430)
        self.form.pack(fill="x")
        tk.Frame(self.form, width=430, height=1, bg=PANEL).pack()   # กำหนดความกว้างขั้นต่ำของฟอร์ม
        if self.mode == "login":
            self._build_login()
        else:
            self._build_register()

    def switch(self, mode, ident=""):
        self.mode = mode
        self._build_card()
        if mode == "login" and ident:
            self.f_ident.set(ident)
            self.f_pw.focus()

    # ----- ฟอร์มเข้าสู่ระบบ ------------------------------------------------
    def _build_login(self):
        self.f_ident = Field(self.form, "ชื่อ นามสกุล หรือ อีเมล")
        self.f_ident.pack(fill="x", pady=(0, 12))
        self.f_pw = Field(self.form, "รหัสผ่าน", secret=True)
        self.f_pw.pack(fill="x", pady=(0, 18))

        ColorButton(self.form, color=ACCENT, text="เข้าสู่ระบบ  →", pady=10,
                    command=self.do_login).pack(fill="x")

        link = tk.Label(self.form, text="ยังไม่มีบัญชี?  สมัครสมาชิกที่นี่", font=(FONT, 9),
                        bg=PANEL, fg=ACCENT, cursor="hand2")
        link.pack(pady=(14, 0))
        link.bind("<Button-1>", lambda e: self.switch("register"))

        self.f_ident.focus()
        for f in (self.f_ident, self.f_pw):
            f.entry.bind("<Return>", lambda e: self.do_login())

    def do_login(self):
        ident = self.f_ident.get().strip()
        pw = self.f_pw.get()
        if not ident or not pw:
            messagebox.showwarning("กรอกข้อมูลไม่ครบ", "กรุณากรอกชื่อ-นามสกุลหรืออีเมล และรหัสผ่าน")
            return
        try:
            user = authenticate(ident, pw)
        except Exception as err:
            messagebox.showerror("ฐานข้อมูลมีปัญหา", describe_db_error(err))
            return
        if user is None:
            messagebox.showerror("เข้าสู่ระบบไม่สำเร็จ",
                                 "ชื่อ-นามสกุล/อีเมล หรือรหัสผ่านไม่ถูกต้อง")
            self.f_pw.clear()
            self.f_pw.focus()
            return
        self.on_login(user)

    # ----- ฟอร์มสมัครสมาชิก ------------------------------------------------
    def _build_register(self):
        tk.Label(self.form, text="ฉันคือ", font=(FONT, 9, "bold"), bg=PANEL,
                 fg=MUTED).pack(anchor="w")
        picker = tk.Frame(self.form, bg=PANEL)
        picker.pack(fill="x", pady=(4, 12))
        self.role_cards = {}
        for key in ("student", "teacher"):
            label, icon, color = ROLE_INFO[key]
            card = tk.Frame(picker, bg=PANEL, highlightthickness=2, cursor="hand2",
                            padx=10, pady=8)
            card.pack(side="left", fill="x", expand=True, padx=(0, 8) if key == "student" else 0)
            tk.Label(card, text=icon, font=(FONT, 18), bg=PANEL).pack(side="left", padx=(0, 8))
            tk.Label(card, text=label, font=(FONT, 11, "bold"), bg=PANEL, fg=INK).pack(side="left")
            bind_click(card, lambda k=key: self._set_role(k))
            self.role_cards[key] = card
        self._paint_roles()

        names = tk.Frame(self.form, bg=PANEL)
        names.pack(fill="x", pady=(0, 10))
        self.f_first = Field(names, "ชื่อ")
        self.f_first.pack(side="left", fill="x", expand=True, padx=(0, 8))
        self.f_last = Field(names, "นามสกุล")
        self.f_last.pack(side="left", fill="x", expand=True)

        self.f_email = Field(self.form, "อีเมล")
        self.f_email.pack(fill="x", pady=(0, 10))

        pws = tk.Frame(self.form, bg=PANEL)
        pws.pack(fill="x", pady=(0, 4))
        self.f_pw1 = Field(pws, f"รหัสผ่าน (≥ {MIN_PASSWORD_LEN} ตัว)", secret=True)
        self.f_pw1.pack(side="left", fill="x", expand=True, padx=(0, 8))
        self.f_pw2 = Field(pws, "ยืนยันรหัสผ่าน", secret=True)
        self.f_pw2.pack(side="left", fill="x", expand=True)

        tk.Label(self.form, text="ชื่อและนามสกุลต้องไม่มีเว้นวรรค · ใช้ชื่อ-นามสกุลหรืออีเมลล็อกอินได้",
                 font=(FONT, 8), bg=PANEL, fg=MUTED).pack(anchor="w", pady=(0, 14))

        ColorButton(self.form, color=ACCENT, text="สร้างบัญชี", pady=10,
                    command=self.do_register).pack(fill="x")

        self.f_first.focus()
        for f in (self.f_first, self.f_last, self.f_email, self.f_pw1, self.f_pw2):
            f.entry.bind("<Return>", lambda e: self.do_register())

    def _set_role(self, key):
        self.role = key
        self._paint_roles()

    def _paint_roles(self):
        for key, card in self.role_cards.items():
            color = ROLE_INFO[key][2]
            selected = key == self.role
            bg = mix(color, 0.88) if selected else PANEL
            card.config(highlightbackground=color if selected else BORDER,
                        highlightcolor=color if selected else BORDER, bg=bg)
            for child in card.winfo_children():
                child.config(bg=bg)

    def do_register(self):
        first = self.f_first.get().strip()
        last = self.f_last.get().strip()
        email = self.f_email.get().strip().lower()
        pw1, pw2 = self.f_pw1.get(), self.f_pw2.get()

        def warn(msg):
            messagebox.showwarning("ข้อมูลไม่ถูกต้อง", msg)

        if not first or not last:
            return warn("กรุณากรอกชื่อและนามสกุล")
        if re.search(r"\s", first) or re.search(r"\s", last):
            return warn("ชื่อและนามสกุลต้องไม่มีเว้นวรรค (กรอกแยกช่องกัน)")
        if len(first) > 50 or len(last) > 50:
            return warn("ชื่อหรือนามสกุลยาวเกินไป (สูงสุด 50 ตัวอักษร)")
        if not EMAIL_RE.match(email) or len(email) > 100:
            return warn("รูปแบบอีเมลไม่ถูกต้อง เช่น somchai@kmitl.ac.th")
        if len(pw1) < MIN_PASSWORD_LEN:
            return warn(f"รหัสผ่านต้องยาวอย่างน้อย {MIN_PASSWORD_LEN} ตัวอักษร")
        if pw1 != pw2:
            return warn("รหัสผ่านและช่องยืนยันไม่ตรงกัน")

        try:
            ok, info = create_user(self.role, first, last, email, pw1)
        except Exception as err:
            messagebox.showerror("ฐานข้อมูลมีปัญหา", describe_db_error(err))
            return
        if not ok:
            if info == "email":
                return warn("อีเมลนี้ถูกใช้สมัครไปแล้ว")
            return warn("มีบัญชีที่ใช้ชื่อ-นามสกุลนี้อยู่แล้ว\n"
                        "(ระบบใช้ชื่อ-นามสกุลล็อกอินได้ จึงซ้ำกันไม่ได้)")
        messagebox.showinfo("สมัครสมาชิกสำเร็จ",
                            f"ยินดีต้อนรับคุณ {first} {last}\nเข้าสู่ระบบเพื่อเริ่มจองห้องได้เลย")
        self.switch("login", ident=email)


